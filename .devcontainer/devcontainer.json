{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.14-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "test.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "[ -f requirements-dev.txt ] && pip3 install --user -r requirements-dev.txt; echo '✅ Pinned dependencies installed'",
  "postAttachCommand": {
    "server": "streamlit run test.py --server.enableCORS true --server.enableXsrfProtection true"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
